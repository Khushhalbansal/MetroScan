# Copy to backend/.env for local overrides, or set these as real environment
# variables in a deployment. Every field on app/core/config.py:Settings can be set
# this way (the name upper-cased). Nothing here is required for local dev — the
# defaults run on SQLite with no services.

# --- deployment ---
ENVIRONMENT=production
# Comma-separated. Must include the deployed frontend origin.
CORS_ORIGINS=https://metroscan.vercel.app

# --- database ---
# SQLAlchemy + psycopg 3. Supabase session-mode pooler, scheme rewritten to
# postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- auth ---
# 48+ random chars. The app refuses to boot outside development on the checked-in
# dev default. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value

# --- paths (set by the Docker image; override only if your layout differs) ---
RULES_DIR=/app/rules
STORAGE_DIR=/data/storage

# --- retention job (Feature 6) ---
RETENTION_SWEEP_ENABLED=true
# RETENTION_SWEEP_INTERVAL_HOURS=24

# --- optional: VLM extractor ---
# EXTRACTOR=hybrid
# ANTHROPIC_API_KEY=sk-ant-...
